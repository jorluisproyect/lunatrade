# SOLO TESTNET. Nunca uses claves reales en esta fase.
CLOUD_MODE=true
SYMBOL=BTCUSDT
TESTNET_ASSIGNED_CAPITAL=100
TESTNET_AUTOTRADE=true
PAPER_STARTING_CAPITAL=10
PAPER_AUTOTRADE=false

BINANCE_TESTNET_API_KEY=PEGA_AQUI_TU_API_KEY_TESTNET
BINANCE_TESTNET_SECRET_KEY=PEGA_AQUI_TU_SECRET_TESTNET

# Seguridad del panel web
LUNATRADE_ACCESS_PASSWORD=CAMBIA_ESTA_CONTRASENA
# Genera 64 caracteres aleatorios. Ejemplo PowerShell en README.
LUNATRADE_SESSION_SECRET=CAMBIA_ESTE_SECRETO_LARGO_DE_64_CARACTERES_MINIMO

# En Railway monta un Volume en /data
LUNATRADE_DATA_DIR=/data
